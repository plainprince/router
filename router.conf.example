# Copy to router.conf (gitignored). Any $VAR / ${VAR:-default} expands from the
# environment.
#
# Keys can go in the optional 4th provider column, right after the shortname:
#   openai,https://api.orcarouter.ai/v1,orcarouter,sk-orca-...
# A bare UPPER_SNAKE value there is read as an environment variable name
# (e.g. OPENROUTER_KEY); use `key:...` or `env:...` to be explicit either way.
# Without a 4th column the variable is <SHORTNAME>_API_KEY.

[providers]
# <api type>,<base url>,<shortname>[,<api key | env var name>]
openai,https://api.openai.com/v1,openai
anthropic,https://api.anthropic.com,anthropic,env:ANTHROPIC_API_KEY

# Web tools (optional, keyless). These are never used for chat: they answer
# POST /v1/web_search and POST /v1/web_fetch, and the `"web": true` requests
# the app sends. Search providers are tried in order, so list a fallback.
duckduckgo,https://html.duckduckgo.com,ddg
wikipedia,https://en.wikipedia.org,wikipedia
# Jina Reader turns any URL into clean text: keyless at 20 rpm, 500 with a key.
jina,https://r.jina.ai,jina
# Jina's search endpoint needs a free key (100 rpm, ~1000 free searches).
# jina-search,https://s.jina.ai,jina-search,env:JINA_API_KEY

[models]
# <provider>/<model>, in failover order
openai/gpt-5-mini
anthropic/claude-sonnet-4-5
